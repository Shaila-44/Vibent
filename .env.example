# Copy this file to .env and fill in your values. Never commit .env.

# Port the server listens on.
PORT=3000

# TMDB credentials (recommended). Either a v3 "API Key" or a v4 "API Read Access Token"
# works; get one free at https://www.themoviedb.org/settings/api (see README).
# If left empty, VIBENT runs in DEMO MODE with fictional sample titles (not TMDB data).
TMDB_API_KEY=

# Optional. If set, messages are interpreted by OpenAI's Chat Completions API
# (with automatic fallback to the built-in rules). If empty, rules are used.
OPENAI_API_KEY=
# Optional. Model used for interpretation when OPENAI_API_KEY is set.
OPENAI_MODEL=gpt-4o-mini

# Optional request timeouts in milliseconds.
# TMDB_TIMEOUT_MS=8000
# OPENAI_TIMEOUT_MS=10000

# Optional. Set to true when running behind a reverse proxy (Render, Fly, Nginx)
# so rate limiting sees real client IPs.
# TRUST_PROXY=false
